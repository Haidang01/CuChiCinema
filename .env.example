DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/cineverse?schema=public
PORT=3001
APP_ORIGIN=http://localhost:5173
# Optional extra exact origins, comma-separated. dev:lan discovers LAN origins automatically.
APP_ORIGINS=
# Optional LAN interface selection (e.g. 192.168.1.10); leave empty for Wi-Fi/Ethernet discovery.
LAN_IP=
LOCAL_TLS_CERT=.local/certs/lan.pem
LOCAL_TLS_KEY=.local/certs/lan-key.pem
NODE_ENV=development
# Optional WebRTC relay for strict NAT. Configure on server only.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Relative to project root, never served as public static files.
MEDIA_ROOT=media
MAX_MEDIA_BYTES=4294967296
