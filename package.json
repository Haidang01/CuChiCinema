{
  "name": "cineverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "format": "prettier --write apps packages scripts tests docs README.md AGENTS.md package.json tsconfig.base.json prisma.config.ts",
    "dev": "concurrently -k -n api,web \"npm run dev -w @cineverse/server\" \"npm run dev -w @cineverse/web\"",
    "build": "npm run build -w @cineverse/web && npm run build -w @cineverse/server",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/server",
    "test": "tsx --test tests/domain.test.ts",
    "test:integration": "tsx scripts/run-integration.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/create-database.ts && npm run db:migrate && npm run db:seed",
    "start": "node --env-file=.env dist/server/apps/server/src/index.js"
  },
  "dependencies": {
    "@cineverse/shared": "*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
